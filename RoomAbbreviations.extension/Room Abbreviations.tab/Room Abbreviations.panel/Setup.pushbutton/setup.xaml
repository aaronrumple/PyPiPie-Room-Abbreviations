<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Abbreviations Setup" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <!-- Replaced at runtime to follow Revit's light/dark theme -->
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Fg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Line" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Accent" Color="#2D7DD2"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#666666"/>
    <SolidColorBrush x:Key="Warn" Color="#B25E00"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="MinWidth" Value="80"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,3,0,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="14,10,14,12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="18,16,18,14">

    <!-- Parameter -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Room Abbreviation parameter" Style="{StaticResource CardTitle}"/>
        <TextBlock x:Name="param_tb" Style="{StaticResource Note}"/>
      </StackPanel>
    </Border>

    <!-- Abbreviations: one source only -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Abbreviations" Style="{StaticResource CardTitle}"/>
        <RadioButton x:Name="keep_rb" GroupName="src"/>
        <RadioButton x:Name="standard_rb" GroupName="src"/>
        <RadioButton x:Name="custom_rb" GroupName="src" Content="Load a custom file (tab-delimited)"/>
        <DockPanel Margin="22,2,0,4">
          <Button x:Name="browse_btn" DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" MinWidth="70"/>
          <TextBox x:Name="path_tb" IsReadOnly="True"/>
        </DockPanel>
        <StackPanel x:Name="mode_sp" Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Existing table:" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <RadioButton x:Name="replace_rb" GroupName="mode" Content="Replace" Margin="0,0,14,0" IsChecked="True"/>
          <RadioButton x:Name="merge_rb" GroupName="mode" Content="Merge (new entries win)"/>
        </StackPanel>
        <TextBlock x:Name="src_note_tb" Style="{StaticResource Note}" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- Room tag -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Room tag" Style="{StaticResource CardTitle}"/>
        <CheckBox x:Name="tag_cb" Content="Open the standard room tag to create a new tag"/>
        <TextBlock x:Name="tag_note_tb" Style="{StaticResource Note}" Margin="22,4,0,0"
                   Text="After setup, a copy of the standard tag opens in the Family Editor. You'll see what to do before it opens."/>
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource Note}" Margin="2,0,0,12"
               Text="Setup fills in every room and shows a report of room names without an abbreviation."/>

    <DockPanel LastChildFill="False">
      <Button x:Name="help_btn" DockPanel.Dock="Left" Content="Help" MinWidth="60"/>
      <Button x:Name="run_btn" DockPanel.Dock="Right" Content="Run Setup" IsDefault="True"
              Style="{StaticResource Primary}" Margin="6,0,0,0"/>
      <Button x:Name="cancel_btn" DockPanel.Dock="Right" Content="Cancel" IsCancel="True"/>
    </DockPanel>
  </StackPanel>
</Window>
